// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum BookingStatus {
  PENDING
  HELD
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentType {
  DEPOSIT
  BALANCE
  FULL_PAYMENT
  REFUND
}

enum PaymentMethod {
  STRIPE
  CASH
  BANK_TRANSFER
  ZELLE
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  BOOKING_IN_PROGRESS
  WON
  LOST
}

enum TimePeriod {
  MORNING
  AFTERNOON
  EVENING
  FULL_DAY
  CUSTOM
}

enum DayType {
  WEEKDAY
  WEEKEND
  HOLIDAY
  SPECIAL_EVENT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  IN_APP
}

enum HoldStatus {
  ACTIVE
  EXPIRED
  CONVERTED
}

enum ActivityType {
  LEAD_CREATED
  ENQUIRY_RECEIVED
  BOOKING_STARTED
  BOOKING_CREATED
  PAYMENT_RECEIVED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  NOTE_ADDED
  WHATSAPP_MESSAGE
  EMAIL_SENT
  STATUS_CHANGED
  BOOKING_COMPLETED
  OWNER_AVAILABILITY_REQUESTED
  OWNER_AVAILABILITY_CONFIRMED
  OWNER_AVAILABILITY_DECLINED
}

enum VerificationStatus {
  PENDING
  AVAILABLE
  UNAVAILABLE
  EXPIRED
  CANCELLED
}

enum ConversationChannel {
  WEBSITE
  WHATSAPP
}

enum ConversationParticipant {
  CUSTOMER
  AI
  ADMIN
}

// ----------------------------------------------------------------------------
// MODELS
// ----------------------------------------------------------------------------

model Yacht {
  id               String  @id @default(uuid())
  slug             String  @unique
  name             String
  shortDescription String? @db.Text
  description      String? @db.Text

  manufacturer String?
  make         String?
  model        String?
  year         Int?
  length       Float // Length of the yacht in feet
  capacity     Int // Maximum number of guests
  cabins       Int     @default(0)
  bathrooms    Int     @default(0)

  location String?
  marina   String?

  isActive    Boolean @default(true)
  isFeatured  Boolean @default(false)
  instantBook Boolean @default(false)

  // Relationships
  images       YachtImage[]
  amenities    YachtAmenity[]
  pricingRules PricingRule[]
  availability Availability[]
  bookings     Booking[]
  bookingHolds BookingHold[]
  reviews      Review[]
  ownerVerifications OwnerVerification[]

  // Timestamps & Soft Delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([isActive])
}

model YachtImage {
  id        String  @id @default(uuid())
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  yachtId String
  yacht   Yacht  @relation(fields: [yachtId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([yachtId, sortOrder])
}

model Amenity {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  icon        String?

  yachts YachtAmenity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model YachtAmenity {
  yachtId   String
  amenityId String

  yacht   Yacht   @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([yachtId, amenityId])
}

model PricingRule {
  id    String @id @default(uuid())
  title String

  dayType    DayType    @default(WEEKDAY)
  timePeriod TimePeriod @default(CUSTOM)

  basePrice  Decimal  @db.Decimal(10, 2)
  hourlyRate Decimal? @db.Decimal(10, 2)

  minDuration Int @default(2) // in hours
  maxDuration Int @default(24) // in hours

  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date
  priority      Int       @default(0)
  isActive      Boolean   @default(true)

  yachtId String
  yacht   Yacht  @relation(fields: [yachtId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([yachtId, isActive])
}

model Availability {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  notes     String? // E.g., "Maintenance" or special notes
  isBlocked Boolean  @default(false) // Entire day blocked

  yachtId String
  yacht   Yacht  @relation(fields: [yachtId], references: [id], onDelete: Cascade)

  timeSlots TimeSlot[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([yachtId, date])
  @@index([yachtId, date])
}

model TimeSlot {
  id        String   @id @default(uuid())
  startTime DateTime @db.Time
  endTime   DateTime @db.Time
  isBlocked Boolean  @default(false)

  availabilityId String
  availability   Availability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  holdId      String?
  bookingHold BookingHold? @relation(fields: [holdId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([availabilityId, startTime, endTime])
}

model BookingHold {
  id             String @id @default(uuid())
  customerRef    String // Session ID or Customer ID to identify who holds it
  idempotencyKey String @unique // To prevent duplicate holds

  startDateTime DateTime @db.Timestamptz
  endDateTime   DateTime @db.Timestamptz
  expiresAt     DateTime @db.Timestamptz

  status HoldStatus @default(ACTIVE)

  // Financial Snapshot (server-computed, immutable after hold creation)
  subtotal          Decimal? @db.Decimal(10, 2)
  totalAmount       Decimal? @db.Decimal(10, 2)
  depositAmount     Decimal? @db.Decimal(10, 2) // 30% of totalAmount — CONFIRMED Chicago Yachts deposit policy
  remainingBalance  Decimal? @db.Decimal(10, 2) // 70% of totalAmount — due on charter date
  depositPercentage Decimal? @db.Decimal(5, 2) // Policy snapshot (30.00) — preserved for historical accuracy
  pricingRuleId     String?

  yachtId String
  yacht   Yacht  @relation(fields: [yachtId], references: [id], onDelete: Cascade)

  timeSlots TimeSlot[]

  // Checkout Draft Details (Temporary pre-payment guest info)
  customerFirstName String?
  customerLastName  String?
  customerEmail     String?
  customerPhone     String?
  guestCount        Int?
  customerNotes     String? @db.Text

  stripeSessionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([yachtId, startDateTime, endDateTime])
  @@index([expiresAt, status])
}

model Booking {
  id               String @id @default(uuid())
  bookingReference String @unique

  startDateTime DateTime @db.Timestamptz
  endDateTime   DateTime @db.Timestamptz
  guestCount    Int

  // Financials
  subtotal       Decimal @db.Decimal(10, 2)
  taxAmount      Decimal @default(0.00) @db.Decimal(10, 2)
  serviceFee     Decimal @default(0.00) @db.Decimal(10, 2)
  addOnTotal     Decimal @default(0.00) @db.Decimal(10, 2)
  discountAmount Decimal @default(0.00) @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)

  depositAmount   Decimal @default(0.00) @db.Decimal(10, 2)
  remainingAmount Decimal @default(0.00) @db.Decimal(10, 2)

  bookingStatus BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  customerNotes String? @db.Text
  internalNotes String? @db.Text

  // Relationships
  yachtId String
  yacht   Yacht  @relation(fields: [yachtId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  timeSlots TimeSlot[]
  notes     BookingNote[]
  addOns    BookingAddOn[]
  payments  PaymentTransaction[]
  notifications Notification[]
  ownerVerifications OwnerVerification[]

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?
  completedAt DateTime?
  deletedAt   DateTime?

  @@index([bookingReference])
  @@index([customerId])
  @@index([yachtId, startDateTime, endDateTime])
}

model BookingNote {
  id       String  @id @default(uuid())
  content  String  @db.Text
  authorId String? // Can reference AdminUser

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AddOn {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text
  price       Decimal @db.Decimal(10, 2)
  pricingType String // e.g., PER_PERSON, PER_BOOKING, PER_HOUR
  isActive    Boolean @default(true)

  bookings BookingAddOn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookingAddOn {
  id          String  @id @default(uuid())
  quantity    Int     @default(1)
  priceAtTime Decimal @db.Decimal(10, 2) // Preserves historical price

  bookingId String
  addOnId   String

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOn   AddOn   @relation(fields: [addOnId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentTransaction {
  id String @id @default(uuid())

  stripeSessionId       String? @unique
  stripePaymentIntentId String? @unique
  stripeChargeId        String? @unique
  stripeRefundId        String? @unique

  type     PaymentType
  method   PaymentMethod @default(STRIPE)
  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("USD")
  status   PaymentStatus @default(PENDING)

  reference String?
  notes     String? @db.Text

  recordedById String?
  recordedBy   AdminUser? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([stripeSessionId])
  @@index([stripePaymentIntentId])
}

model Customer {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  email     String  @unique
  phone     String?

  leadStatus    LeadStatus @default(NEW)
  source        String?
  lifetimeValue Decimal    @default(0.00) @db.Decimal(10, 2)

  bookings      Booking[]
  reviews       Review[]
  notes         CustomerNote[]
  activities    CustomerActivity[]
  conversations Conversation[]
  notifications Notification[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
}

model CustomerNote {
  id       String  @id @default(uuid())
  content  String  @db.Text
  authorId String? // Can reference AdminUser

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerActivity {
  id          String       @id @default(uuid())
  type        ActivityType
  description String       @db.Text
  metadata    Json? // Storing extra details like bookingRef

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([customerId, createdAt(sort: Desc)])
}

model Conversation {
  id      String              @id @default(uuid())
  channel ConversationChannel @default(WEBSITE)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id      String                  @id @default(uuid())
  role    ConversationParticipant
  content String                  @db.Text

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt(sort: Asc)])
}

model Notification {
  id         String              @id @default(uuid())
  type       String // BOOKING_CONFIRMATION, PAYMENT_REMINDER, etc.
  channel    NotificationChannel
  status     NotificationStatus  @default(PENDING)
  providerId String? // e.g., Resend Message ID
  error      String?             @db.Text

  recipient String // Email address or Phone number
  sentAt    DateTime?

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  email        String    @unique
  passwordHash String
  role         String    @default("ADMIN") // e.g., SUPER_ADMIN, ADMIN, MANAGER
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  recordedTransactions PaymentTransaction[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Review {
  id         String  @id @default(uuid())
  rating     Int // 1 to 5
  comment    String? @db.Text
  isApproved Boolean @default(false)

  yachtId String
  yacht   Yacht  @relation(fields: [yachtId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model OwnerVerification {
  id String @id @default(uuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  yachtId String
  yacht   Yacht @relation(fields: [yachtId], references: [id], onDelete: Cascade)

  requestedDate     DateTime @db.Date
  requestedTimeSlot String

  status VerificationStatus @default(PENDING)
  notes  String?            @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  respondedAt DateTime?

  @@index([bookingId])
  @@index([yachtId, status])
}
